# Local Docker mode: http://localhost:3000
# Keep the existing POSTGRES_PASSWORD if an old PostgreSQL Docker volume already contains data.
POSTGRES_PASSWORD=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NUXT_PUBLIC_APP_URL=http://localhost:3000
COOKIE_SECURE=false

# Public TauHorse data are already the defaults in Nuxt/Compose; override only when needed.
NUXT_PUBLIC_SHOP_NAME=TauHorse
NUXT_PUBLIC_SHOP_EMAIL=zoloto666@inbox.ru
NUXT_PUBLIC_SHOP_PHONE=+79013520534

# Optional SMTP for local email testing
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ORDER_NOTIFICATION_EMAIL=

# Optional: only needed for ./scripts/deploy-test.sh
DOMAIN=test.tauhorse.ru
LETSENCRYPT_EMAIL=replace-with-real-email@example.com
