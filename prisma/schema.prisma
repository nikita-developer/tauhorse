generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  role       String   @default("user")
  created_at DateTime @default(now())
  order_notifications_enabled Boolean @default(true)
  marketing_emails_enabled Boolean @default(false)
  marketing_consent_at DateTime?
  marketing_consent_revoked_at DateTime?
  marketing_consent_version String?
  email_verified_at DateTime?
  is_active Boolean @default(true)
  can_manage_orders Boolean @default(false)
  can_manage_catalog Boolean @default(false)
  can_manage_discounts Boolean @default(false)
  can_manage_campaigns Boolean @default(false)

  orders                Order[]
  assigned_orders       Order[] @relation("OrderAssignedManager")
  credited_orders       Order[] @relation("OrderCreditedManager")
  order_status_changes  OrderStatusHistory[] @relation("OrderStatusChangedBy")
  audit_logs            AuditLog[] @relation("AuditActor")
  cart                  Cart?
  refresh_tokens        RefreshToken[]
  password_reset_tokens PasswordResetToken[]
  email_verification_tokens EmailVerificationToken[]
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  created_at  DateTime @default(now())

  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  sku         String?  @unique
  brand       String?
  animal_type String   @default("horse")
  package_weight_kg Decimal? @db.Decimal(8, 3)
  composition String?
  feeding_guide String?
  country_of_origin String?
  shelf_life_months Int?
  manufacturer_name String?
  manufacturer_address String?
  storage_conditions String?
  conformity_number String?
  conformity_url String?
  usage_restrictions String?
  tnved_code String?
  okpd2_code String?
  feed_additive_registration_number String?
  feed_additive_registry_url String?
  image_url   String?
  category_id Int?
  created_at  DateTime @default(now())
  is_deleted  Boolean  @default(false)
  sale_percent Decimal @default(0) @db.Decimal(5, 2)
  sale_starts_at DateTime?
  sale_ends_at DateTime?
  promo_label String?
  is_featured Boolean @default(false)
  catalog_position Int @default(1000)

  category    Category?   @relation(fields: [category_id], references: [id])
  order_items OrderItem[]
  cart_items  CartItem[]
  media       ProductMedia[]
  shared_cart_items SharedCartItem[]

  @@index([category_id])
  @@index([is_deleted])
  @@index([catalog_position, created_at])
}

model ProductMedia {
  id         Int      @id @default(autoincrement())
  product_id Int
  url        String
  storage_key String  @unique
  media_type String
  mime_type  String
  size_bytes Int
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, sort_order])
}

model Cart {
  id          Int      @id @default(autoincrement())
  user_id     Int?     @unique
  guest_token String?  @unique
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user  User?      @relation(fields: [user_id], references: [id])
  items CartItem[]
}

model CartItem {
  id         Int      @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int
  created_at DateTime @default(now())

  cart    Cart    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])

  @@unique([cart_id, product_id])
}

model Order {
  id           Int      @id @default(autoincrement())
  user_id      Int?
  guest_token  String?
  email        String
  name         String
  phone        String
  address      String
  status       String   @default("pending")
  subtotal     Decimal  @default(0) @db.Decimal(12, 2)
  delivery_price Decimal @default(0) @db.Decimal(12, 2)
  delivery_price_confirmed Boolean @default(false)
  total_price  Decimal  @db.Decimal(12, 2)
  discount_percent Decimal @default(0) @db.Decimal(5, 2)
  discount_amount Decimal @default(0) @db.Decimal(12, 2)
  delivery_method String @default("courier")
  postal_code  String?
  comment      String?
  admin_note   String?
  idempotency_key String @unique
  terms_accepted_at DateTime
  terms_version String?
  access_token String   @unique
  created_at   DateTime @default(now())
  assigned_manager_id Int?
  assigned_at DateTime?
  credited_manager_id Int?
  completed_at DateTime?
  cancelled_at DateTime?
  cancelled_by_customer Boolean @default(false)

  user           User?                @relation(fields: [user_id], references: [id])
  assigned_manager User? @relation("OrderAssignedManager", fields: [assigned_manager_id], references: [id], onDelete: SetNull)
  credited_manager User? @relation("OrderCreditedManager", fields: [credited_manager_id], references: [id], onDelete: SetNull)
  items          OrderItem[]
  status_history OrderStatusHistory[]

  @@index([user_id])
  @@index([guest_token])
  @@index([created_at])
  @@index([assigned_manager_id])
  @@index([credited_manager_id])
}

model OrderItem {
  id         Int   @id @default(autoincrement())
  order_id   Int
  product_id Int
  quantity   Int
  price      Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [order_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  token_hash String    @unique
  user_id    Int
  expires_at DateTime
  created_at DateTime  @default(now())
  revoked_at DateTime?

  user_agent String?
  ip_address String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model OrderStatusHistory {
  id          Int      @id @default(autoincrement())
  order_id    Int
  from_status String
  to_status   String
  changed_by  Int?
  created_at  DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  changed_by_user User? @relation("OrderStatusChangedBy", fields: [changed_by], references: [id], onDelete: SetNull)
  change_source String @default("staff")

  @@index([order_id])
  @@index([changed_by])
  @@index([created_at])
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  user_id    Int
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  user_id    Int
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
}

model DiscountRule {
  id Int @id @default(autoincrement())
  min_subtotal Decimal @unique @db.Decimal(12, 2)
  percent Decimal @db.Decimal(5, 2)
  is_active Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model SharedCart {
  id Int @id @default(autoincrement())
  token_hash String @unique
  created_at DateTime @default(now())
  expires_at DateTime
  items SharedCartItem[]
  @@index([expires_at])
}

model SharedCartItem {
  id Int @id @default(autoincrement())
  shared_cart_id Int
  product_id Int
  quantity Int
  shared_cart SharedCart @relation(fields: [shared_cart_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])
  @@unique([shared_cart_id, product_id])
  @@index([shared_cart_id])
}

model MarketingCampaign {
  id Int @id @default(autoincrement())
  subject String
  body String
  status String @default("draft")
  sent_count Int @default(0)
  failed_count Int @default(0)
  created_at DateTime @default(now())
  sent_at DateTime?
}

model AuditLog {
  id Int @id @default(autoincrement())
  actor_user_id Int?
  action String
  entity_type String
  entity_id Int?
  entity_label String?
  details Json?
  ip_address String?
  created_at DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([actor_user_id])
  @@index([entity_type, entity_id])
  @@index([action])
  @@index([created_at])
}
